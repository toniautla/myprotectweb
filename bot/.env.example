# ─────────────────────────────────────────────────────────────
#  MyProtect Bot — environment variables
#  Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN="your-bot-token"

# Application (client) id — same app as the dashboard.
DISCORD_CLIENT_ID="your-discord-client-id"

# MongoDB connection string — MUST be the same database the dashboard uses.
MONGO_URI="mongodb://localhost:27017"

# Public base URL of the dashboard (used by /dashboard buttons & links).
DASHBOARD_URL="http://localhost:3000"

# Optional: register slash commands to a single guild for instant updates
# while developing. Leave empty to register commands globally (can take ~1h
# to propagate the first time).
DEV_GUILD_ID=""
