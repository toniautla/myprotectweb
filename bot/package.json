{
  "name": "myprotect-bot",
  "version": "1.0.0",
  "private": true,
  "description": "MyProtect Discord bot — shares a MongoDB with the MyProtect dashboard.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "^20.17.10",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "mongodb": "^6.12.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": "20.x"
  }
}
