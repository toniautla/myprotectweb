# ─────────────────────────────────────────────────────────────
#  MyProtect Dashboard — environment variables
#  Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (SHARED with the Discord bot in /bot).
MONGO_URI="mongodb://localhost:27017"

# Discord application OAuth2 credentials
# https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# NextAuth
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-string"
# Public base URL of the dashboard (used for OAuth redirects).
NEXTAUTH_URL="http://localhost:3000"

# ── Public (exposed to the browser) ──
# Used to build the "Invite Bot" link. Same value as DISCORD_CLIENT_ID.
NEXT_PUBLIC_DISCORD_CLIENT_ID="your-discord-client-id"
# Permissions integer for the invite link (8 = Administrator).
NEXT_PUBLIC_DISCORD_INVITE_PERMISSIONS="8"

# NOTE: In the Discord Developer Portal, add this OAuth2 redirect URL:
#   http://localhost:3000/api/auth/callback
