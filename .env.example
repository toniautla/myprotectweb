# ─────────────────────────────────────────────────────────────
#  MyProtect Dashboard — environment variables
#  Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (SHARED with the Discord bot in /bot).
MONGO_URI="mongodb://localhost:27017"

# Discord application OAuth2 credentials
# https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Session signing secret. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-string"

# Public base URL of the dashboard. REQUIRED in production — the OAuth2
# redirect_uri is built from it. https://, no trailing slash, must match the
# domain you actually use and the redirect registered in Discord.
NEXTAUTH_URL="http://localhost:3000"

# Permissions integer for the bot "Invite" link (8 = Administrator).
DISCORD_INVITE_PERMISSIONS="8"

# NOTE: In the Discord Developer Portal, add this OAuth2 redirect URL:
#   http://localhost:3000/api/auth/callback
