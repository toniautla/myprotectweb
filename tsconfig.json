{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  },
  "include": ["next-env.d.ts", "components/**/*.ts", "components/**/*.tsx", "lib/**/*.ts", "pages/**/*.ts", "pages/**/*.tsx", "styles/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "bot"]
}
